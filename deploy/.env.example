# seat-hub production settings for docker compose (copy to deploy/.env).
# Do not set PORTAL_DB_PATH or PORTAL_LISTEN here: the image already points
# them at the /data volume and port 8790.

# Public address users and payment callbacks see (no trailing slash).
PORTAL_PUBLIC_BASE_URL=https://api.example.com
# >= 32 random bytes: openssl rand -base64 48. Never change it afterwards:
# it encrypts the stored vm2api keys and signs sessions.
PORTAL_SECRET_KEY=
# First administrator, created on first start only.
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=

# vm2api control plane. On the same host: http://host.docker.internal:8787
VM2API_BASE_URL=http://host.docker.internal:8787
VM2API_MASTER_KEY=

# Optional
# PORTAL_MAX_BODY_MB=128
# In-site update: where releases come from, an optional GitHub token for a
# higher API rate limit, and how long a restart waits for in-flight requests.
# PORTAL_UPDATE_REPO=DueGin/seat-hub
# PORTAL_UPDATE_TOKEN=
# PORTAL_UPDATE_DRAIN_SECONDS=20
# Behind a proxy to reach GitHub:
# HTTPS_PROXY=http://127.0.0.1:7890
