[Unit]
Description=vm2api-portal (account hosting / rental storefront)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vm2api-portal
EnvironmentFile=/opt/vm2api-portal/.env
ExecStart=/opt/vm2api-portal/bin/vm2api-portal
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
